<Layout xmlns="urn:speedata.de/2021/xts/en"
    xmlns:sd="urn:speedata.de/2021/xtsfunctions/en">

    <!-- text-box-trim: trim-end on the paragraphs of a Flow. The band ends
         with the grid's ninth row, at 108pt; seven lines of 15.6pt need
         109.2pt, but the seventh line's text ends about 2pt higher, so it
         fits by its text and its leading lies below the band. The second
         Flow, without the trim, puts six lines on its page. -->

    <PageFormat width="100mm" height="60mm"/>
    <SetGrid width="5mm" height="12pt"/>
    <StyleSheet>
        p { margin: 0; font-size: 10pt; line-height: 15.6pt }
        .trim { text-box-trim: trim-end }
    </StyleSheet>
    <Record match="data">
        <Flow>
            <ForAll select="line">
                <Paragraph class="trim"><Value select="concat('Trimmed line ', @n)"/></Paragraph>
            </ForAll>
        </Flow>
        <ClearPage/>
        <Flow>
            <ForAll select="line">
                <Paragraph><Value select="concat('Line ', @n)"/></Paragraph>
            </ForAll>
        </Flow>
    </Record>
</Layout>
